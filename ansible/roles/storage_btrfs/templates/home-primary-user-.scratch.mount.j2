[Unit]
Description=Scratch (cache, regenerable) subvolume for {{ primary_user }}
After=local-fs-pre.target
Before=local-fs.target

[Mount]
What={{ storage_btrfs_root_device_final }}
Where={{ storage_btrfs_scratch_mountpoint }}
Type=btrfs
Options={{ storage_btrfs_scratch_mount_options }}
DirectoryMode=0700

[Install]
WantedBy=local-fs.target
